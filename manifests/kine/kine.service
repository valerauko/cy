[Unit]
Description=Kine - Lightweight etcd replacement with sqlite backend
After=network.target
Before=kubelet.service

[Service]
Type=simple
User=root
ExecStartPre=-/usr/bin/mkdir -p /var/lib/kine
ExecStart=/usr/local/bin/kine --listen-address 127.0.0.1:2379 --endpoint sqlite:///var/lib/kine/db.sqlite --server-cert-file /etc/kubernetes/pki/etcd/server.crt --server-key-file /etc/kubernetes/pki/etcd/server.key --trusted-ca-file /etc/kubernetes/pki/ca.crt
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kine

[Install]
WantedBy=multi-user.target
